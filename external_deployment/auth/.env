# Keycloak bootstrap credentials, also used by the health check and IPR API.
# Replace these public demo defaults before deploying.
KC_BOOTSTRAP_ADMIN_USERNAME=
KC_BOOTSTRAP_ADMIN_PASSWORD=

# Published Redis host port; containers continue to use redis:6379.
REDIS_HOST_PORT=

# SMTP config for Keycloak password-reset emails.
# Replace the placeholder values below with your SMTP values.
# Could be a real Gmail account and App Password or other services such as Amazon SES, Postmark, etc
SMTP_HOST=
SMTP_PORT=
SMTP_FROM=
SMTP_FROM_DISPLAY_NAME=
SMTP_STARTTLS=
SMTP_SSL=
SMTP_AUTH=
SMTP_USERNAME=
SMTP_PASSWORD=
