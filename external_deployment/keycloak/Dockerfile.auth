# The Keycloak 26 image is based on ubi9-micro and ships no package manager,
# so the healthcheck tools (curl, jq, openssl) are installed into a separate
# root filesystem and copied over the Keycloak image.
FROM registry.access.redhat.com/ubi9 AS ubi-micro-build
RUN mkdir -p /mnt/rootfs
RUN dnf install --installroot /mnt/rootfs curl-minimal jq openssl \
        --releasever 9 --setopt install_weak_deps=false --nodocs -y && \
    dnf --installroot /mnt/rootfs clean all && \
    rpm --root /mnt/rootfs -e --nodeps setup

FROM quay.io/keycloak/keycloak:26.8.2
COPY --from=ubi-micro-build /mnt/rootfs /
USER root
# Realm files in this directory are imported by `kc.sh start --import-realm`.
RUN mkdir -p /opt/keycloak/data/import
# Docker initializes the shared key volume from this root-owned directory.
# Keycloak runs as root; API containers only need read/traverse permission.
RUN mkdir -p /keys && chmod 755 /keys
COPY keycloak/kc_setup_keyfile.sh /scripts/kc_setup_keyfile.sh
COPY keycloak/kc_entrypoint.sh /scripts/kc_entrypoint.sh
RUN chmod a+x /scripts/kc_setup_keyfile.sh /scripts/kc_entrypoint.sh
COPY keycloak/kc_realm_export.json /opt/keycloak/data/import/PORI-realm.json
ENTRYPOINT ["/scripts/kc_entrypoint.sh"]
# overriding ENTRYPOINT resets the base image CMD, so restore it
CMD ["start", "--import-realm"]
